{
  "expo": {
    "name": "TAITIT tool",
    "slug": "taitit-configurador",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "taitit",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.taititeyewear.configurador",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.taititeyewear.configurador"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 320
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "TAITIT uses your photos so you can send pictures of a frame that needs a spare part.",
          "cameraPermission": "TAITIT uses the camera so you can photograph a frame that needs a spare part.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "thirdkghs-team",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "802eb207-8810-4e8b-9ede-c0463e88ecf2"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "TAITIT",
      "shortName": "TAITIT"
    }
  }
}
